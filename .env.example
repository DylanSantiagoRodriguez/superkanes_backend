# Copiar a .env y completar las credenciales de PostgreSQL.
POSTGRES_DB=superkanes
POSTGRES_PORT=5432
DB_HOST=127.0.0.1
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SWAGGER_ENABLED=true
AUTH_ISSUER=superkanes-api
AUTH_AUDIENCE=superkanes-clients
# Ejecutar npm run auth:setup para generar 64 bytes aleatorios.
AUTH_JWT_SECRET=

# npm run storage:setup genera credenciales locales; nunca se envían al frontend.
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=superkanes
S3_ACCESS_KEY=superkanes-app
S3_SECRET_KEY=
MINIO_ROOT_USER=superkanes-root
MINIO_ROOT_PASSWORD=
# PostgreSQL Docker queda en 5433 para no interferir con instalaciones locales.
POSTGRES_DOCKER_PORT=5433
# Opcional: reutilizar un volumen PostgreSQL existente (misma versión/imagen).
# POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_VOLUME_NAME=nombre-del-volumen-existente
# POSTGRES_VOLUME_EXTERNAL=true
