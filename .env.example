# Copiar a .env y completar las credenciales de PostgreSQL.
POSTGRES_DB=superkanes
POSTGRES_PORT=5432
DB_HOST=127.0.0.1
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SWAGGER_ENABLED=true
AUTH_ISSUER=superkanes-api
AUTH_AUDIENCE=superkanes-clients
# Ejecutar npm run auth:setup para generar 64 bytes aleatorios.
AUTH_JWT_SECRET=
